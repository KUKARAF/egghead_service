# Production Secrets Template
# Copy to .env and fill in actual values
# DO NOT commit .env to git

# ====== REQUIRED SECRETS ======

# OIDC Authentication (auth.osmosis.page)
OIDC_CLIENT_ID=your-production-oidc-client-id
OIDC_CLIENT_SECRET=your-production-oidc-client-secret

# KV Store Access (kv.osmosis.page - for OpenRouter secret)
KV_API_KEY=your-production-kv-api-key

# ====== OPTIONAL SECRETS ======

# Session signing key (32-byte hex)
# Leave empty to auto-generate (NOT recommended for production)
# Generate with: openssl rand -hex 32
SESSION_SIGNING_KEY=your-32-byte-hex-key-here

# ====== PRODUCTION NOTES ======

# Database location: ./data/egghead.db (SQLite)
# - Persisted in Docker volume: egghead_data
# - Backup daily: docker cp egghead_service:/app/data/egghead.db /backups/egghead.db.$(date +%Y%m%d)
# - Restore: docker cp /backups/egghead.db.YYYYMMDD egghead_service:/app/data/egghead.db && restart

# OIDC Redirect URL (configured in auth.osmosis.page):
# - https://userscripts.osmosis.page/auth/callback

# Public config is in docker-compose.prod.yml (no secrets)
# - BASE_URL: https://userscripts.osmosis.page
# - KV_URL: https://kv.osmosis.page
# - WORKER_POLL_INTERVAL_SECS: 5
# - MAX_HTML_BYTES: 150000
# - LOG_FORMAT: json (structured logging)
