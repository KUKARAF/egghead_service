DATABASE_URL=sqlite:./egghead.db
LISTEN_ADDR=0.0.0.0:3000
ENV=DEVELOPMENT

OIDC_ISSUER_URL=https://auth.osmosis.page/application/o/egghead/
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=https://egghead.osmosis.page/auth/callback

SESSION_SIGNING_KEY=  # 32-byte hex; auto-generated if empty (ephemeral)
BASE_URL=https://egghead.osmosis.page

# Fetch OpenRouter API key from kv.osmosis.page
KV_API_KEY=your-kv-api-key-here
KV_URL=https://kv.osmosis.page

WORKER_POLL_INTERVAL_SECS=5
MAX_HTML_BYTES=150000

LOG_FORMAT=  # set to "json" for structured logging
