# Docker Compose Environment Template
# Copy to .env and fill in your values, then run: docker-compose up

# OIDC Configuration (auth.osmosis.page)
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_REDIRECT_URI=https://egghead.osmosis.page/auth/callback

# KV Store Configuration (for fetching OpenRouter API key)
KV_API_KEY=your-kv-api-key
KV_URL=https://kv.osmosis.page

# Session Configuration
SESSION_SIGNING_KEY=  # 32-byte hex; auto-generated if empty

# Base URL (used in frontend links/redirects)
BASE_URL=https://egghead.osmosis.page

# Optional: Tune worker behavior
WORKER_POLL_INTERVAL_SECS=5
MAX_HTML_BYTES=150000

# Optional: Enable JSON logging
LOG_FORMAT=
